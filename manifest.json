{
  "manifest_version": 3,
  "name": "NoKakulaLeveling",
  "version": "1.3.0",
  "description": "Удали Какула Левелинг из своего чата!",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["browser-polyfill.js", "filter.js", "content.js", "chat-input.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["page-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["patterns.json"],
      "matches": ["https://www.twitch.tv/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nokakulaleveling@subakon.dev",
      "strict_min_version": "128.0",
    }
  }
}
